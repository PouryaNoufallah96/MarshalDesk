# Copy to .env.local and fill in values from the Neon Development branch.

# Neon Auth
# Auth URL from the Neon console (Auth > Configuration)
NEON_AUTH_BASE_URL=
# Random secret (32+ characters) that signs the session cookie cache
NEON_AUTH_COOKIE_SECRET=

# Database
# Pooled Neon connection string, used at runtime by @marshaldesk/db
DATABASE_URL=

# Neon Object Storage (S3-compatible)
# Access key ID of the branch's storage credential
AWS_ACCESS_KEY_ID=
# Secret access key of the branch's storage credential
AWS_SECRET_ACCESS_KEY=
# Branch storage endpoint, like https://<branch-id>.storage.<region>.aws.neon.tech
AWS_ENDPOINT_URL_S3=
# Storage region, like eu-central-1
AWS_REGION=
# Public-read bucket for agent avatars, like profile-images
STORAGE_PROFILE_IMAGES_BUCKET=
# Base URL for anonymous reads; objects live at <base>/<bucket>/<key>
STORAGE_PUBLIC_BASE_URL=
# Private bucket for knowledge base source files, like uploads
STORAGE_UPLOADS_BUCKET=

# Neon Functions
# Base URL of the deployed `jobs` function, without a trailing slash
FUNCTIONS_URL=
# Shared secret the web app sends as a bearer token to the `jobs` function; `pnpm functions:deploy:dev` reads it from this file into the function's env
FUNCTIONS_SECRET=

# Neon AI Gateway
# Gateway host root from the Neon console (AI Gateway), without /v1
NEON_AI_GATEWAY_BASE_URL=
# Gateway token for the branch
NEON_AI_GATEWAY_TOKEN=

# App
# Origin of this app, like http://localhost:3000 (also the storage CORS origin)
NEXT_PUBLIC_APP_URL=

# Tokens and real time
# Secret that signs visitor tokens (base64, 32+ bytes)
VISITOR_TOKEN_SECRET=
# Secret that signs real-time connection tokens (random string, 32+ characters); same value in apps/realtime/.dev.vars
REALTIME_TOKEN_SECRET=
# Shared secret the server uses to publish to real-time rooms; same value in apps/realtime/.dev.vars
REALTIME_PUBLISH_SECRET=
# HTTP URL of the real-time server, like https://marshaldesk-realtime-dev.<account>.workers.dev (the `jobs` function is deployed with this value, so it can't be localhost); publishing is skipped when unset
REALTIME_URL=
# Host the browser connects to for real time, like localhost:8787
NEXT_PUBLIC_REALTIME_HOST=
