{
  "name": "@marshaldesk/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm embed:build && next dev",
    "build": "pnpm embed:build && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "embed:build": "esbuild embed/loader.ts --bundle --minify --format=iife --target=es2019 --outfile=public/embed.js",
    "embed:watch": "pnpm embed:build --watch",
    "storage:cors": "node --env-file=.env.local scripts/configure-storage-cors.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@aws-sdk/s3-request-presigner": "3.1143.0",
    "@base-ui/react": "^1.8.0",
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@hookform/resolvers": "^5.9.1",
    "@marshaldesk/db": "workspace:*",
    "@marshaldesk/shared": "workspace:*",
    "@neondatabase/auth": "0.5.0-beta",
    "@orpc/client": "2.0.0-beta.40",
    "@orpc/contract": "2.0.0-beta.40",
    "@orpc/openapi": "2.0.0-beta.40",
    "@orpc/server": "2.0.0-beta.40",
    "@orpc/tanstack-query": "2.0.0-beta.40",
    "@orpc/zod": "2.0.0-beta.40",
    "@tanstack/react-query": "^5.104.0",
    "@vercel/functions": "3.9.9",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "input-otp": "^1.5.0",
    "jose": "6.2.12",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^4.14.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "ua-parser-js": "1.0.41",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ua-parser-js": "0.7.39",
    "esbuild": "0.28.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
