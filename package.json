{
  "name": "marshaldesk",
  "private": true,
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node api.js && pnpm --filter @marshaldesk/web dev",
    "build": "node api.js && pnpm --filter @marshaldesk/web build",
    "functions:plan:dev": "neon config plan --project-id flat-cloud-39881619 --branch br-falling-forest-b1bz9ifj --env apps/web/.env.local",
    "functions:deploy:dev": "neon deploy --project-id flat-cloud-39881619 --branch br-falling-forest-b1bz9ifj --env apps/web/.env.local --no-env-pull",
    "realtime:deploy:dev": "pnpm --filter @marshaldesk/realtime deploy:dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@neon/config": "1.8.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3"
  }
}
