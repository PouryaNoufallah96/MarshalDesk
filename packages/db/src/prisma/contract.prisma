// use prisma-8

enum MemberRole {
  @@type("pg/text@1")
  Owner = "owner"
}

enum WidgetColor {
  @@type("pg/text@1")
  Blue   = "blue"
  Indigo = "indigo"
  Violet = "violet"
  Pink   = "pink"
  Red    = "red"
  Orange = "orange"
  Green  = "green"
}

enum WidgetPosition {
  @@type("pg/text@1")
  BottomLeft  = "bottom-left"
  BottomRight = "bottom-right"
}

model Workspace {
  id             Uuid                  @id @default(uuid(7))
  name           String
  agentEnabled   Boolean               @default(true) @map("agent_enabled")
  // Null means "{workspace name} Agent", so renaming the workspace carries over.
  agentName      String?               @map("agent_name")
  agentAvatarKey String?               @map("agent_avatar_key")
  color          WidgetColor           @default(Blue)
  position       WidgetPosition        @default(BottomRight)
  greeting       String?
  allowedDomains String[]              @default([]) @map("allowed_domains")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      temporal.updatedAt() @map("updated_at")

  members Member[]

  @@map("workspaces")
}

model Member {
  id          Uuid                  @id @default(uuid(7))
  workspaceId Uuid                  @map("workspace_id")
  userId      Uuid                  @unique @map("user_id")
  role        MemberRole
  name        String
  avatarUrl   String?               @map("avatar_url")
  avatarKey   String?               @map("avatar_key")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   temporal.updatedAt() @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("members")
}
