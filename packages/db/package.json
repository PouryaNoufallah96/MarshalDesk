{
  "name": "@marshaldesk/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "contract:emit": "prisma contract emit",
    "migration:plan": "prisma migration plan",
    "db:migrate": "prisma db migrate --advance-ref db",
    "lint": "eslint .",
    "postinstall": "prisma contract emit",
    "typecheck": "prisma contract emit && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/orm-extension-pgvector": "8.0.0-rc.13",
    "@prisma/orm-postgres": "8.0.0-rc.13",
    "dotenv": "18.0.4",
    "temporal-polyfill": "1.0.5"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "prisma": "8.0.0-rc.17"
  }
}
